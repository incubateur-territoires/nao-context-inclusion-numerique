# Variables pour nao sync (a exporter avant de lancer la commande, nao ne lit pas .env tout seul)
#   set -a; . ./.env; set +a
# Copier vers .env et renseigner les valeurs (ne pas committer .env)

NAO_DB_HOST=localhost
NAO_DB_PORT=5432
NAO_DB_NAME=inclusion_numerique
NAO_DB_USER=nao_ro
NAO_DB_PASSWORD=CHANGE_ME
